rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // This mirrors the application's current @blend.global access check.
    // TODO: Require verified email addresses or custom admin claims before
    // treating email/password accounts as trusted CMS editors.
    function isBlendMember() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@blend[.]global$');
    }

    // Public reads are required by the unauthenticated Next.js server-side
    // Firestore client and are appropriate for published website content.
    match /cmsSettings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isBlendMember();
    }

    match /blogPosts/{documentId} {
      allow read: if true;
      allow create, update, delete: if isBlendMember();
    }

    match /services/{documentId} {
      allow read: if true;
      allow create, update, delete: if isBlendMember();
    }

    match /caseStudies/{documentId} {
      allow read: if true;
      allow create, update, delete: if isBlendMember();
    }

    match /projectEnquiries/{enquiryId} {
      allow read: if isBlendMember();
      allow create: if isBlendMember()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.services is list
        && request.resource.data.services.size() <= 16
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.emailNotification == { 'status': 'pending' };
      allow update: if isBlendMember()
        && resource.data.submittedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailNotification', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.emailNotification.keys().hasOnly(['status'])
        && request.resource.data.emailNotification.status in ['sent', 'failed'];
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
