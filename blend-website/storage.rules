rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isBlendMember() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@blend[.]global$');
    }

    match /cms/blog-covers/{fileName} {
      allow read: if true;
      allow write: if isBlendMember()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
